# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=admin123

# Server Configuration
PORT=5000

# Observability / OpenTelemetry (OTel) Configuration
OTEL_ENABLED=true
OTEL_SERVICE_NAME=three-tier-product-api
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=production
# Standard OTLP HTTP receiver endpoint (e.g., local collector, Grafana Alloy/Tempo, SigNoz, Datadog OTel agent)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
